# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Virtual environments and local environment variables
.venv/
venv/
env/
ENV/
.env
.env.*
!.env.example

# Packaging and build output
build/
dist/
*.egg-info/
.eggs/

# Jupyter
.ipynb_checkpoints/

# Datasets and generated file lists
/dataset/
*.flist

# Model weights: keep only the three pretrained weights at the root of weights/
*.pth
*.pt
*.ckpt
*.onnx
/weights/*
!/weights/lolv1.pth
!/weights/lolv2real.pth
!/weights/sice.pth

# Training and evaluation artifacts: keep only each stage's latest checkpoint
/runs/**
!/runs/**/
!/runs/**/latest.pth
/checkpoints/
/results/
/logs/
events.out.tfevents*

# Editors and operating systems
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db
